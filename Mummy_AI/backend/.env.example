PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Ollama must be installed, running, and have this model pulled locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Optional MongoDB Atlas connection. Never commit a real URI or credentials.
MONGODB_URI=
MONGODB_DB=mummyai
# Seeds fictional child profiles only; real records are not supported.
SEED_SYNTHETIC_DATA=true
# Set to "demo" to disable Ollama and use fixed demo responses.
AI_MODE=agent
